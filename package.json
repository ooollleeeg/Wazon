{
  "name": "oid-registry-system",
  "version": "1.0.0",
  "description": "Система реєстру об'єктів інформаційної діяльності",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run react-dev\" \"npm run server-dev\"",
